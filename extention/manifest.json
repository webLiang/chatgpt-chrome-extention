{
   "action": {
      "default_icon": {
         "16": "images/icon16.png",
         "32": "images/icon32.png",
         "48": "images/icon48.png"
      },
      "default_title": "ChatGPT"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Ctrl+Shift+Period",
            "mac": "Command+Shift+Period"
         }
      },
      "open-codex-side-panel": {
         "description": "Open ChatGPT side panel"
      }
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "content-scripts/chatgpt-website.js" ],
      "matches": [ "https://chatgpt.com/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "content-scripts/codex-work-preload.js" ],
      "matches": [ "https://chatgpt.com/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "all_frames": true,
      "include_globs": [ "*surface=browser_side_chat*" ],
      "js": [ "content-scripts/side-chat-tab-mentions.js" ],
      "matches": [ "https://chatgpt.com/*" ],
      "run_at": "document_start",
      "world": "ISOLATED"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https://ab.chatgpt.com https://chatgpt.com https://api.openai.com https://api.openai.org https://*.blob.core.windows.net https://*.oaiusercontent.com https://*.s3.ap-northeast-1.amazonaws.com https://*.s3.ap-northeast-2.amazonaws.com https://*.s3.ap-south-1.amazonaws.com https://*.s3.ap-southeast-1.amazonaws.com https://*.s3.ap-southeast-2.amazonaws.com https://*.s3.ca-central-1.amazonaws.com https://*.s3.eu-central-1.amazonaws.com https://*.s3.eu-south-2.amazonaws.com https://*.s3.eu-west-1.amazonaws.com https://*.s3.eu-west-2.amazonaws.com https://*.s3.us-east-1.amazonaws.com https://*.s3.us-east-2.amazonaws.com https://*.s3.us-west-1.amazonaws.com; font-src 'self' https://cdn.openai.com;",
      "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'none';"
   },
   "description": "Control your browser with ChatGPT.",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "images/icon128.png",
      "16": "images/icon16.png",
      "32": "images/icon32.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "116",
   "name": "ChatGPT",
   "optional_permissions": [ "downloads.open" ],
   "permissions": [ "alarms", "bookmarks", "debugger", "declarativeNetRequestWithHostAccess", "downloads", "favicon", "history", "nativeMessaging", "notifications", "offscreen", "scripting", "sessions", "storage", "tabGroups", "tabs", "topSites", "webNavigation", "contextMenus", "sidePanel" ],
   "sandbox": {
      "pages": [ "js-kernel.html" ]
   },
   "side_panel": {
      "default_path": "side-panel-loading.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.26.1005.11759",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "images/cursor-chat.png" ]
   } ]
}
